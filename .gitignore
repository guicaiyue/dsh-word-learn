# 依赖
node_modules/
.pnpm-store/

# 构建产物（不入库：本地 link 安装先 pnpm build；npm 包靠 prepublish 构建后随 tarball 发布）
dist/

# 本地测试产物与临时目录（测试脚本自己造临时 DSH_HOME）
.tmp/
coverage/
*.log

# 本机同步 / 缓存
# 注意：data/ecdict.db 是构建产物，但仓库有意跟踪（开箱可用），不要加进忽略
cache/
.sync_temp_dir/

# 本地个人配置
*.local.json
.env
.env.*

# 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/
.vscode/
.scratch/
