{
  "name": "dsh-word-learn",
  "version": "0.1.0",
  "description": "DSH 英语单词学习：划词即查、按词频分级、间隔重复复习，面向以英语为工作语言的开发者",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./assets/dashboard.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "assets",
    "data",
    "locale/*.json",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "english",
    "vocabulary",
    "word-learning",
    "spaced-repetition",
    "fsrs",
    "划词",
    "背单词"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "node --test",
    "test:unit:coverage": "node --experimental-test-coverage --test-coverage-include=lib/http.mjs --test-coverage-include=lib/text.js --test-coverage-include=lib/models.mjs --test-coverage-lines=95 --test-coverage-branches=85 --test-coverage-functions=95 --test \"tests/**/*.test.mjs\"",
    "test:legacy": "node scripts/test-all.mjs",
    "test": "pnpm test:unit && pnpm test:unit:coverage && pnpm test:legacy",
    "check:cycles": "node scripts/check-cycles.mjs",
    "check": "pnpm lint && pnpm format:check && pnpm check:cycles",
    "verify": "pnpm check && pnpm test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "dependencies": {
    "ts-fsrs": "6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10"
  }
}
